# ==========================================
# AgriSaarthi Environment Variables Example
# ==========================================

# NOTE: Do NOT put real secrets in this file. 
# Copy this to .env and fill in the values for local development.

# --- Backend (.NET Web API) ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=localhost;Database=AgriSaarthi;Trusted_Connection=True;MultipleActiveResultSets=true
Jwt__Issuer=your_issuer_here
Jwt__Audience=your_audience_here
Jwt__Key=your_super_secret_key_placeholder

# --- AI Service (FastAPI) ---
PYTHON_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=../ml/models/

# --- External APIs ---
# Weather API placeholder (e.g., OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key_placeholder
